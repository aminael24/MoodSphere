# ===========================================
# MoodSphere v2 - Backend Configuration
# ===========================================
# Copiez ce fichier en ".env"

PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/moodsphere

# --- JWT ---
JWT_SECRET=changez_moi_par_une_chaine_secrete_tres_longue
JWT_EXPIRES_IN=7d

# --- IA ---
# Cle gratuite HuggingFace (https://huggingface.co/settings/tokens)
# Laisser vide pour utiliser le fallback local par mots-cles
HUGGINGFACE_API_KEY=

# --- Email (Nodemailer) ---
# Laisser EMAIL_HOST vide pour desactiver l'envoi (les tokens s'afficheront en console)
# Pour Gmail : utilisez un "mot de passe d'application" (pas votre vrai mdp)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=MoodSphere <no-reply@moodsphere.app>

# --- Frontend ---
CLIENT_URL=http://localhost:5173
